{
    "name": "chromatic/usher",
    "description": "A collection of Robo commands for use on Chromatic projects.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Mark Dorison",
            "email": "mark@dorison.org"
        },
        {
            "name": "Adam Zimmermann",
            "email": "adam@adamzimmermann.com"
        },
        {
            "name": "Kristofer Widholm",
            "email": "279278+apotek@users.noreply.github.com"
        }
    ],
    "require": {
        "consolidation/robo": "^1.4 || ^2 || ^3 || ^4 || ^5",
        "squizlabs/php_codesniffer": "^3.5 || ^4.0",
        "phpstan/phpstan-deprecation-rules": "^0.12.6 || ^1.0.0 || ^2.0.0",
        "async-aws/s3": "^1.8 || ^2.0 || ^3.0",
        "php": ">=8.1",
        "drush/drush": "^8 || ^10 || ^11 || ^12 || ^13",
        "vincentlanglet/twig-cs-fixer": "^0.4.1 || ^0.5 || ^0.6 || ^1.0 || ^2.0 || ^3.0 || ^4.0",
        "dealerdirect/phpcodesniffer-composer-installer": "^0.7.2 || ^1.0.0",
        "phpstan/extension-installer": "^1.1",
        "phpcompatibility/php-compatibility": "^9.3",
        "guzzlehttp/guzzle": "^5.0 || ^6.0 || ^7.0",
        "symfony/yaml": "^6.3 || ^7.0 || ^8.0"
    },
    "autoload": {
        "psr-4": {
            "Usher\\": "src"
        }
    },
    "scripts": {
        "phpcs": "composer robo job:check-coding-standards",
        "phpcbf": "composer robo job:fix-coding-standards",
        "phpstan": "composer robo job:run-static-analysis",
        "rector": "vendor/bin/rector process --dry-run",
        "rector-fix": "vendor/bin/rector process",
        "robo": "robo --ansi",
        "test": [
            "@phpcs",
            "@phpstan",
            "@rector"
        ]
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true,
            "php-http/discovery": true,
            "drupal/core-composer-scaffold": true
        }
    },
    "require-dev": {
        "phpstan/phpstan-strict-rules": "^1.5 || ^2.0",
        "drupal/core": "*",
        "phpunit/phpunit": "*",
        "rector/rector": "^0.16.0 || ^0.17.0 || ^0.18.0 || ^0.19.0 || ^1.0.0 || ^2.0.0",
        "webflo/drupal-finder": "^1.2"
    }
}
